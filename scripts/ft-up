#!/usr/bin/env bash
# Bring FreeToken up in its ONE default profile and wait until it serves. No steps to remember:
#   ft-up            start (clears any failed state; touches NOTHING else on the GPU) and wait
#   ft-up --no-wait  start and return immediately
# Installed into ~/.local/bin by scripts/systemd/install.sh. Companion: ft-down.
set -u
LOG=${FREETOKEN_LOG:-$HOME/.cache/freetoken/logs/ft_serve.log}
PORT=${FREETOKEN_PORT:-8080}
UNIT=freetoken-serve
if systemctl is-active --quiet "$UNIT" && curl -sf -m 3 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
  echo "freetoken-serve already up on :$PORT"; exit 0
fi
before=$(wc -l < "$LOG" 2>/dev/null || echo 0)
sudo -n systemctl reset-failed "$UNIT" 2>/dev/null
sudo -n systemctl start "$UNIT" || { echo "start failed: sudo systemctl status $UNIT" >&2; exit 1; }
[ "${1:-}" = "--no-wait" ] && { echo "starting; log: $LOG"; exit 0; }
t0=$(date +%s)
printf "loading"
while :; do
  if tail -n +"$((before + 1))" "$LOG" 2>/dev/null | grep -q "API server is ready"; then
    echo; echo "ready on http://127.0.0.1:$PORT after $(( $(date +%s) - t0 )) s"
    tail -n +"$((before + 1))" "$LOG" | grep -oE "memory_ratio=[0-9.]+|Free GPU memory after capturing CUDA graphs: [0-9.]+ GiB" | sort -u
    exit 0
  fi
  if ! systemctl is-active --quiet "$UNIT"; then
    echo; echo "server died during load; tail of $LOG:" >&2
    tail -n +"$((before + 1))" "$LOG" | grep -E "Traceback|Error|out of memory" | tail -5 >&2
    exit 1
  fi
  [ $(( $(date +%s) - t0 )) -gt 900 ] && { echo; echo "timeout (15 min); see $LOG" >&2; exit 1; }
  printf "."; sleep 5
done

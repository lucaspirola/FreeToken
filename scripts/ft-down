#!/usr/bin/env bash
# Stop FreeToken and hand the GPU back. On a host that has the piro-board embedder user unit,
# the server unit's ExecStopPost restarts it; on any other host there is nothing to restore.
# Installed into ~/.local/bin by scripts/systemd/install.sh. Companion: ft-up.
set -u
UNIT=freetoken-serve
sudo -n systemctl stop "$UNIT"
sudo -n systemctl reset-failed "$UNIT" 2>/dev/null
echo "freetoken-serve: $(systemctl is-active "$UNIT")"
if systemctl --user cat piro-board-embedder.service >/dev/null 2>&1; then
  sleep 2; echo "piro-board-embedder: $(systemctl --user is-active piro-board-embedder)"
fi
nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader 2>/dev/null | sed 's/^/GPU memory used\/total: /'

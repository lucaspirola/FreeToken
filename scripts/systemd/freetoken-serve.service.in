# Persistent FreeToken server. TEMPLATE: rendered + installed by scripts/systemd/install.sh
# (sudo scripts/systemd/install.sh), which fills @USER@ @HOME@ @REPO@ @UID@ for this host.
# Control: sudo systemctl {start,stop,restart,status} freetoken-serve ; log: ~/.cache/freetoken/logs/ft_serve.log
# A SYSTEM unit (not --user) because only PID 1 can grant LimitMEMLOCK=infinity, which the
# whole-model-in-RAM profile needs (the user manager's hard cap left MoE banks pageable).
# Not enabled at boot on purpose: other GPU services (e.g. the piro-board embedder) own the
# GPU by default and this unit coexists with whatever is running.
[Unit]
Description=FreeToken server (scripts/serve-default.sh; default Ornith Q6_K / Ada)
After=network.target
# Never rate-limit starts: a crashed/stopped server must come back with a plain `start`
# (ft-up), no `reset-failed` ritual.
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@REPO@
Environment=HOME=@HOME@
Environment=PATH=@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/wsl/lib
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
# Whatever else is on the GPU stays there: this unit stops nothing before starting (the
# memory ratio is a fraction of the VRAM that is FREE, so the server sizes itself to what is
# left) and brings nothing back up on stop. Freeing the GPU is someone else's decision.
ExecStart=@REPO@/scripts/serve-default.sh
StandardOutput=append:@HOME@/.cache/freetoken/logs/ft_serve.log
StandardError=append:@HOME@/.cache/freetoken/logs/ft_serve.log
OOMScoreAdjust=1000
LimitMEMLOCK=infinity
TimeoutStopSec=90
SuccessExitStatus=143
Restart=no

[Install]
WantedBy=multi-user.target

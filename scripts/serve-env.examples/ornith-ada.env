# Ornith Q6_K on RTX 2000 Ada 16 GB (profile measured 2026-09-17, fork 1b2799e).
# Optional host overrides; the launcher uses these defaults even without this file.
# The checkpoint must exist at FREETOKEN_MODEL. Install dependencies and the system unit,
# then start and tune on EACH host; ratio 1.00 passed here, not a guarantee on another GPU.
# Tested with 64 GB WSL RAM ([wsl2] memory=64GB), 8K/80K/256K probes at ratio 1.00
# YaRN x2 over native 262144 gives the 524288 ceiling.
FREETOKEN_MODEL=$HOME/ai/models/Ornith-1.5-35B-Q6_K.gguf
FREETOKEN_PORT=8080
FREETOKEN_MODEL_NAME=ornith1.5-35b
FREETOKEN_REASONING_PARSER=qwen3
FREETOKEN_PIN_BUDGET_GB=32
FREETOKEN_HOST_RAM_RESERVE_GB=4
FREETOKEN_MEMORY_RATIO=1.00
TVM_FFI_CUDA_ARCH_LIST=8.9
FREETOKEN_EXTRA_ARGS='--sampling-defaults model --max-seq-len-override 524288 --num-tokens 524288 --rope-yarn-factor 2 --rope-yarn-original-context 262144 --max-prefill-length 4096 --enable-special-token-ckpt --decode-log-interval 10'
